# SIEMBA Environment Variables
# Copy to .env and fill in all values
# Never commit .env to git

# Core
SIEMBA_DOMAIN=siemba.yourcompany.com
NODE_ENV=production
PORT=3000
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Elasticsearch
ES_HOST=http://127.0.0.1:9200
ES_USERNAME=elastic
ES_PASSWORD=REPLACE_ME

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_PASSWORD=REPLACE_ME

# TheHive
THEHIVE_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
THEHIVE_URL=http://127.0.0.1:9000
THEHIVE_API_KEY=

# Microsoft 365 / Azure
# Azure Portal > App Registrations > New Registration
# Required permissions: AuditLog.Read.All, Directory.Read.All, SecurityEvents.Read.All
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_POLL_INTERVAL_SECONDS=300

# Google Workspace
# Google Cloud Console > Service Accounts > create key > JSON
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_WORKSPACE_DOMAIN=
GOOGLE_POLL_INTERVAL_SECONDS=300

# Jira
JIRA_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=security@yourcompany.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SEC
JIRA_ISSUE_TYPE=Task

# Microsoft Teams
TEAMS_WEBHOOK_URL=
TEAMS_ALERT_MIN_SEVERITY=high

# Slack
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#security-alerts
SLACK_CRITICAL_CHANNEL=#security-critical
SLACK_ALERT_MIN_SEVERITY=high

# Threat Intelligence
THREAT_INTEL_UPDATE_INTERVAL=3600
MISP_URL=
MISP_API_KEY=

# Security Tools
NUCLEI_TEMPLATES_PATH=/root/nuclei-templates
NUCLEI_RATE_LIMIT=150
METASPLOIT_RPC_HOST=127.0.0.1
METASPLOIT_RPC_PORT=55553
METASPLOIT_RPC_USER=msf
METASPLOIT_RPC_PASS=REPLACE_ME

# Let's Encrypt
LETSENCRYPT_EMAIL=admin@yourcompany.com

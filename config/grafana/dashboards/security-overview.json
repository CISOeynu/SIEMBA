{
  "title": "SIEMBA — Security Overview",
  "uid": "siemba-overview",
  "tags": ["siemba", "security", "overview"],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1, "gridPos": {"x":0,"y":0,"w":4,"h":4},
      "type": "stat", "title": "Critical Alerts (24h)",
      "datasource": {"type":"elasticsearch","uid":"siemba-es"},
      "targets": [{
        "query": "siemba_severity:critical",
        "metrics": [{"type":"count","id":"1"}],
        "bucketAggs": []
      }],
      "options": { "colorMode": "background", "thresholds": {"steps":[{"color":"green","value":null},{"color":"red","value":1}]} }
    },
    {
      "id": 2, "gridPos": {"x":4,"y":0,"w":4,"h":4},
      "type": "stat", "title": "Threat Intel Hits (24h)",
      "datasource": {"type":"elasticsearch","uid":"siemba-ti"},
      "targets": [{
        "query": "*",
        "metrics": [{"type":"count","id":"1"}],
        "bucketAggs": []
      }],
      "options": { "colorMode": "background", "thresholds": {"steps":[{"color":"green","value":null},{"color":"orange","value":1}]} }
    },
    {
      "id": 3, "gridPos": {"x":8,"y":0,"w":4,"h":4},
      "type": "stat", "title": "Total Events (24h)",
      "datasource": {"type":"elasticsearch","uid":"siemba-es"},
      "targets": [{
        "query": "*",
        "metrics": [{"type":"count","id":"1"}],
        "bucketAggs": []
      }]
    },
    {
      "id": 4, "gridPos": {"x":0,"y":4,"w":12,"h":8},
      "type": "timeseries", "title": "Events by Severity Over Time",
      "datasource": {"type":"elasticsearch","uid":"siemba-es"},
      "targets": [{
        "query": "*",
        "metrics": [{"type":"count","id":"1"}],
        "bucketAggs": [
          {"type":"terms","field":"siemba_severity","id":"2","settings":{"size":"4"}},
          {"type":"date_histogram","field":"@timestamp","id":"3","settings":{"interval":"auto"}}
        ]
      }]
    },
    {
      "id": 5, "gridPos": {"x":12,"y":0,"w":12,"h":12},
      "type": "table", "title": "Recent Critical & High Events",
      "datasource": {"type":"elasticsearch","uid":"siemba-es"},
      "targets": [{
        "query": "siemba_severity:(critical OR high)",
        "metrics": [{"type":"logs","id":"1"}],
        "bucketAggs": []
      }]
    },
    {
      "id": 6, "gridPos": {"x":0,"y":12,"w":8,"h":8},
      "type": "piechart", "title": "Events by Integration",
      "datasource": {"type":"elasticsearch","uid":"siemba-es"},
      "targets": [{
        "query": "*",
        "metrics": [{"type":"count","id":"1"}],
        "bucketAggs": [{"type":"terms","field":"source_integration","id":"2","settings":{"size":"10"}}]
      }]
    },
    {
      "id": 7, "gridPos": {"x":8,"y":12,"w":16,"h":8},
      "type": "table", "title": "Threat Intel Hits",
      "datasource": {"type":"elasticsearch","uid":"siemba-ti"},
      "targets": [{
        "query": "*",
        "metrics": [{"type":"logs","id":"1"}],
        "bucketAggs": []
      }]
    }
  ]
}

     "targets":[{"query":"*","metrics":[{"type":"count","id":"1"}],"bucketAggs":[]}]},
    {"id":2,"gridPos":{"x":6,"y":0,"w":6,"h":4},"type":"stat","title":"Critical Events",
     "datasource":{"type":"elasticsearch","uid":"siemba-google"},
     "targets":[{"query":"siemba_severity:critical","metrics":[{"type":"count","id":"1"}],"bucketAggs":[]}]},
    {"id":3,"gridPos":{"x":0,"y":4,"w":24,"h":8},"type":"timeseries","title":"Google Workspace Events Over Time",
     "datasource":{"type":"elasticsearch","uid":"siemba-google"},
     "targets":[{"query":"*","metrics":[{"type":"count","id":"1"}],"bucketAggs":[{"type":"date_histogram","field":"@timestamp","id":"2","settings":{"interval":"auto"}}]}]},
    {"id":4,"gridPos":{"x":0,"y":12,"w":24,"h":10},"type":"table","title":"Recent Events",
     "datasource":{"type":"elasticsearch","uid":"siemba-google"},

  "tags": ["siemba","google"],
  "timezone": "browser",
  "schemaVersion": 36,
  "refresh": "60s",
  "time": {"from":"now-24h","to":"now"},
  "panels": [
    {"id":1,"gridPos":{"x":0,"y":0,"w":6,"h":4},"type":"stat","title":"Total Google Events",
